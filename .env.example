# ==============================================================================
# ShowroomOS — Environment Configuration Template (.env.example)
# ==============================================================================
# For local development on macOS/Linux, copy only if you need overrides:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit `.env` or real service-account JSON key files.
# - Do NOT require GOOGLE_APPLICATION_CREDENTIALS when Application Default
#   Credentials (Cloud Run service account or `gcloud auth application-default login`)
#   already exist and hold IAM permissions on the target Firebase project.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND CONFIGURATION (Bundled via JSON — no env vars required)
# ------------------------------------------------------------------------------
# Public Firebase Web SDK identifiers live in `firebase-applet-config.json`.
# Current provisioned Firebase resource identifiers (non-secret):
#   Firebase Project ID:      cybernetic-stage-bv0ns
#   Named Firestore Database: ai-studio-showroomosdealer-b79aa1c8-25ec-4df7-91d6-05becba07015
#   Auth Domain:              cybernetic-stage-bv0ns.firebaseapp.com

# ------------------------------------------------------------------------------
# 2. OPTIONAL SERVER RUNTIME OVERRIDES (Defaults already work out of the box)
# ------------------------------------------------------------------------------
# HTTP port for Express + Vite/dist (defaults to 3000 if omitted)
PORT=3000

# Set to "production" when starting the built production bundle (`npm start`)
# NODE_ENV=production

# Optional overrides; if omitted, server.ts reads them from `firebase-applet-config.json`
# FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
# FIREBASE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"

# ------------------------------------------------------------------------------
# 3. OPTIONAL SERVER-SIDE CREDENTIAL METHODS (Only if ADC lacks IAM permissions)
# ------------------------------------------------------------------------------
# By default, server.ts and scripts/*.ts call `applicationDefault()`:
#   - On Cloud Run / GCP: uses the attached runtime service account automatically
#     (requires roles/datastore.user and roles/firebaseauth.admin on the Firebase project).
#   - On macOS/local: uses `gcloud auth application-default login` automatically.
#
# Only if runtime Application Default Credentials are unavailable or belong to a
# different GCP project without IAM permissions on the Firebase project, supply
# ONE of the following server-side secret methods (never set both simultaneously):
#
# Option A — Server-side JSON secret (recommended for Cloud Run / Secret Manager):
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID",...}'
#
# Option B — Local key file path (optional local-machine fallback):
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/your-firebase-service-account.json"

# ------------------------------------------------------------------------------
# 4. OPTIONAL ADMIN BOOTSTRAP & DEPLOYMENT METADATA
# ------------------------------------------------------------------------------
# Optional verified email permitted to activate the initial `admin` session on
# first sign-in (defaults to the project owner email if omitted).
# BOOTSTRAP_OWNER_EMAIL="owner@your-dealership.example"

# Optional public HTTPS URL after client domain cutover (for deployment records)
# APP_URL="https://showroom.your-client-domain.example"
